{
  "name": "opentip",
  "version": "0.1.0",
  "private": true,
  "description": "Free, self-hostable anonymous tip reporting platform",
  "scripts": {
    "dev": "next dev",
    "dev:db": "node scripts/dev-db.mjs",
    "build": "next build",
    "vercel-build": "node scripts/migrate.mjs && next build",
    "start": "next start",
    "migrate": "node scripts/migrate.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "keys": "node scripts/gen-keys.mjs",
    "reset-2fa": "node scripts/reset-2fa.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/s3-request-presigner": "^3.1140.0",
    "@node-rs/argon2": "^2.2.1",
    "csv-parse": "^7.0.3",
    "ffmpeg-static": "^5.3.0",
    "file-type": "^22.1.1",
    "next": "^16.3.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
